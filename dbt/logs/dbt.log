WITH PreClicks AS (
    SELECT
        click_id,
        kafka_offset AS __browser_kafka_offset,
        0 AS __device_kafka_offset,
        0 AS __geo_kafka_offset
        FROM `ods_ods`.`browser_data`
        WHERE 1 = 1
        
            AND kafka_offset > (SELECT max(__browser_kafka_offset) FROM `ods_dds`.`fct_click`)
        

    UNION ALL

    SELECT
        click_id,
        0 AS __browser_kafka_offset,
        kafka_offset AS __device_kafka_offset,
        0 AS __geo_kafka_offset
        FROM `ods_ods`.`device_data`
        WHERE 1 = 1
        
            AND kafka_offset > (SELECT max(__device_kafka_offset) FROM `ods_dds`.`fct_click`)
        

    UNION ALL

    SELECT
        click_id,
        0 AS __browser_kafka_offset,
        0 AS __device_kafka_offset,
        kafka_offset AS __geo_kafka_offset
        FROM `ods_ods`.`geo_data`
        WHERE 1 = 1
        
            AND kafka_offset > (SELECT max(__geo_kafka_offset) FROM `ods_dds`.`fct_click`)
        
),

Clicks AS (
    SELECT 
        click_id,
        MAX(__browser_kafka_offset) AS __browser_kafka_offset,
        MAX(__device_kafka_offset) AS __device_kafka_offset,
        MAX(__geo_kafka_offset) AS __geo_kafka_offset
    FROM PreClicks
    GROUP BY
        click_id
)


