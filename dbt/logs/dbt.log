        create table `ods_dm`.`dashboard`
        
  
        
  engine = ReplacingMergeTree(__dds_load_time)
        order by ((event_date, geo_country, browser_name, device_is_mobile, utm_source))
        
        
        SETTINGS  replicated_deduplication_window=0

            empty
          as (
            

SELECT
    toDate(fct.event_timestamp) AS event_date,
    COALESCE(geo.geo_country, 'Unknown') AS geo_country,
    COALESCE(br.browser_name, 'Unknown') AS browser_name,
    COALESCE(dv.device_is_mobile, false) AS device_is_mobile,
    COALESCE(loc.utm_source, 'direct') AS utm_source,
    COALESCE(loc.utm_medium, 'none') AS utm_medium,
    COALESCE(loc.utm_campaign, 'none') AS utm_campaign,
    countDistinct(fct.click_id) AS unique_clicks,
    count(fct.event_id) AS total_events,
    countIf(dv.device_is_mobile = true) AS mobile_clicks,
    fct.__dds_load_time as __dds_load_time
FROM `ods_dds`.`fct_click` AS fct
LEFT JOIN `ods_dds`.`dim_geo` AS geo ON fct.click_id = geo.click_id
LEFT JOIN `ods_dds`.`dim_browser` AS br ON fct.click_id = br.click_id AND fct.event_id = br.event_id
LEFT JOIN `ods_dds`.`dim_device` AS dv ON fct.click_id = dv.click_id
LEFT JOIN `ods_dds`.`dim_location` AS loc ON fct.event_id = loc.event_id
WHERE 1 = 1

GROUP BY event_date, geo_country, browser_name, device_is_mobile, utm_source, utm_medium, utm_campaign, __dds_load_time
          )
